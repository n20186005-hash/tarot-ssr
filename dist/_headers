# 为所有目录下的 JS 文件声明正确的 MIME 类型（核心修复）
/*.js
  Content-Type: text/javascript; charset=utf-8

# 兼容旧的 application/javascript 类型（可选，增强兼容性）
/assets/*.js
  Content-Type: application/javascript

# 若项目有 Wasm 文件，补充这行（没有则删除）
/*.wasm
  Content-Type: application/wasm

# 若项目有 ES 模块文件（.mjs），补充这行（没有则删除）
/*.mjs
  Content-Type: text/javascript; charset=utf-8
